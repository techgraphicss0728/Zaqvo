# Zaqvo Backend — copy to .env and fill (never commit real secrets).
#   cp .env.example .env
#
# .env is gitignored. This file is a safe template for GitHub.

APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MongoDB — put Atlas URI in .env only (never commit credentials here)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=zaqvo

# Redis (cache + Celery broker + optional rate-limit storage)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
USE_REDIS_RATE_LIMIT=false

# JWT — change SECRET_KEY in production
SECRET_KEY=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP validity (minutes) for signup/login across all roles
OTP_TTL_MINUTES=5

# Super admin bootstrap (seeded on startup when no super admin exists)
# Put your real mobile ONLY in .env — not here.
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_NAME=Super Admin

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# SMS / BSNL — required in production; in development OTP is logged to the API terminal if empty
BSNL_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJodHRwOi8vc2NoZW1hcy54bWxzb2FwLm9yZy93cy8yMDA1LzA1L2lkZW50aXR5L2NsYWltcy9uYW1lIjoiMTA5NzMgMiIsIm5iZiI6MTc2NjEzMjQyNCwiZXhwIjoxNzk3NjY4NDI0LCJpc3MiOiJodHRwczovL2J1bGtzbXMuYnNubC5pbjo1MDEwIiwiYXVkIjoiMTA5NzMgMiJ9.SnUc_ARxKcW1f5I6sbrYvI0GTE9KeyLBBjOcmuknG1U
BSNL_ADMIN_LOGIN_TEMPLATE_ID=1407172975491145102

# S3 uploads (product images stored at products/{product_id}/{filename})
S3_BUCKET_NAME=zaqvo
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom CDN/base URL for public image links
# S3_PUBLIC_URL_BASE=
# S3_UPLOAD_MAX_BYTES=5242880
# S3_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
